# Cookie for the photo album at upload.d0b0.lv.
# Copy this file to web/.env.local and paste the real trip_auth value.
# Only the dev server uses it, to attach the cookie when proxying photo
# requests; production is served from a *.d0b0.lv subdomain where the browser
# sends the cookie itself.
TRIP_AUTH_COOKIE=paste-the-trip_auth-value-here

# Optional: point the dev proxy elsewhere (staging, or a local stand-in).
# TRIP_ALBUM_ORIGIN=https://upload.d0b0.lv

# Optional: override the viewer password (default: Mikro2026).
# VITE_TRIP_PASSWORD=Mikro2026
